#!/usr/bin/env bash
set -euo pipefail

export MAGIC_NIX_CACHE_LISTEN="127.0.0.1:37515"

upload_logs="${BUILDKITE_PLUGIN_FLAKEHUB_CACHE_UPLOAD_LOGS:-"true"}"
push_enabled="${BUILDKITE_PLUGIN_FLAKEHUB_CACHE_PUSH:-true}"

if [[ "${push_enabled}" != "true" ]]; then
  echo "push disabled; no Magic Nix Cache to drain"
  exit 0
fi

# TEMPORARY WORKAROUND — remove when Determinate Systems gives us a
# first-class way to push to the FlakeHub cache ourselves (a supported push
# CLI/API instead of magic-nix-cache's daemon-event side channel).
#
# nsh whole-graph builds (`--store nsh://`) copy their outputs back into the
# local store instead of building them here, so determinate-nixd emits no
# built-path events and mnc's upload set stays empty ("paths: []"). Nor do
# such builds leave ./result out-links (out-links are only created for
# local-FS stores), so the store itself is the only record: enqueue every
# path registered in the local store since the job's command started.
# Gated on the command actually using nsh, so ordinary jobs (whose builds
# are already event-enqueued) skip the store scan.
if [[ "${BUILDKITE_COMMAND:-}" == *"nsh://"* ]] \
    && [[ -r "/tmp/fhc-cmd-start-${BUILDKITE_JOB_ID}" ]]; then
  cmd_start="$(cat "/tmp/fhc-cmd-start-${BUILDKITE_JOB_ID}")"
  # The payload travels by file: thousands of paths overflow the 128 KiB
  # per-argument exec limit if passed inline.
  payload="/tmp/fhc-enqueue-${BUILDKITE_JOB_ID}.json"
  if nix path-info --all --json 2>/dev/null \
      | jq --compact-output --argjson t "$cmd_start" \
          'to_entries | map(select((.value.registrationTime // 0) >= $t) | .key) | {store_paths: .}' \
          > "$payload"; then
    n="$(jq '.store_paths | length' "$payload")"
    if (( n > 0 )); then
      echo "Enqueueing ${n} store paths registered since the command started (nsh build outputs)"
      curl -sf -X POST -H 'Content-Type: application/json' \
        -d @"$payload" "http://${MAGIC_NIX_CACHE_LISTEN}/api/enqueue-paths" > /dev/null \
        || echo "WARNING: enqueue-paths failed (HTTP or transport); FlakeHub upload set may be incomplete"
    fi
  fi
  rm -f "$payload"
fi
rm -f "/tmp/fhc-cmd-start-${BUILDKITE_JOB_ID}"

# Drain Magic Nix Cache
rc=0
curl -XPOST "http://${MAGIC_NIX_CACHE_LISTEN}/api/workflow-finish" > /dev/null || rc=$?

if [[ $rc == 0 ]]; then
  echo "Store paths successfully pushed to FlakeHub Cache!"
fi

if [[ $upload_logs == "true" ]]; then
  buildkite-agent artifact upload "/tmp/mnc-${BUILDKITE_JOB_ID}.log"
else
  echo "Skipping log upload"
fi

exit $rc
