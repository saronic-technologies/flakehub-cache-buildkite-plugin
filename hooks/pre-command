#!/usr/bin/env bash
set -euo pipefail

os="$(uname -s)"
arch="$(uname -m)"

export MAGIC_NIX_CACHE_LISTEN="127.0.0.1:37515"

case "${os}" in
  Linux)
    export DETERMINATE_NIX_INSTALL_URL="https://install.determinate.systems/nix?ci=buildkite"
    nix_profile_path="/root/.nix-profile/bin"

    case "${arch}" in
      x86_64)  closure_arch="X64-Linux" ;;
      aarch64) closure_arch="ARM64-Linux" ;;
      *) echo "Unsupported Linux architecture: ${arch}"; exit 1 ;;
    esac

    ;;
  Darwin)
    export DETERMINATE_NIX_INSTALL_URL="https://install.determinate.systems/determinate-pkg/stable/Universal"
    nix_profile_path="/nix/var/nix/profiles/default/bin"

    case "${arch}" in
      x86_64) closure_arch="X64-macOS" ;;
      arm64)  closure_arch="ARM64-macOS" ;;
      *) echo "Unsupported macOS architecture: ${arch}"; exit 1 ;;
    esac
    ;;
  *)
    echo "Unsupported OS: ${os}"
    exit 1
    ;;
esac

export MAGIC_NIX_CACHE_CLOSURE_URL="https://install.determinate.systems/magic-nix-cache-closure/stable/${closure_arch}"

if ! determinate-nixd version &>/dev/null; then
  echo "Installing Determinate Nix"

  case "${os}" in
    Linux)
      curl --proto '=https' --tlsv1.2 -sSf -L "${DETERMINATE_NIX_INSTALL_URL}" | \
        sh -s -- install linux \
          --no-confirm \
          --init none

      nohup /usr/local/bin/determinate-nixd daemon &
      export NIX_REMOTE="daemon"
      ;;
    Darwin)
      curl --proto '=https' --tlsv1.2 -sSf -L "${DETERMINATE_NIX_INSTALL_URL}" -o /tmp/Determinate.pkg
      sudo installer -pkg /tmp/Determinate.pkg -target /
      ;;
  esac

  echo "Waiting for Determinate Nixd status..."

  while ! determinate-nixd status &>/dev/null; do
    sleep 0.1;
  done

  echo "Determinate Nix installed"
else
  echo "Determinate Nix detected, skipping install"
fi

# Set PATH to include Nix-created directories
PATH="${PATH}:${nix_profile_path}"

plugin_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=lib/auth.sh
source "${plugin_dir}/lib/auth.sh"

push_enabled="${BUILDKITE_PLUGIN_FLAKEHUB_CACHE_PUSH:-true}"

# NOTE: the login command only exists on Determinate Nix v3.21.0 and later.
# Skip when the host-wide token is still fresh (a concurrent job on a
# multi-agent host may have just minted one).
if login_needed; then
  echo "Logging in to FlakeHub using Buildkite auth method"
  flakehub_login
  echo "Login successful"
else
  echo "FlakeHub token still fresh; skipping login"
fi

# OIDC-minted FlakeHub sessions are short-lived, so keep the login fresh for
# the whole job. The refresher renews only when the token nears expiry or the
# cache rejects it; pre-exit tears it down.
refresher_log="/tmp/flakehub-refresher-${BUILDKITE_JOB_ID}.log"
refresher_pidfile="/tmp/flakehub-refresher-${BUILDKITE_JOB_ID}.pid"
nohup bash "${plugin_dir}/lib/refresher.sh" "$PPID" &> "${refresher_log}" &
echo $! > "${refresher_pidfile}"
disown

if [[ "${push_enabled}" != "true" ]]; then
  echo "push disabled; not starting Magic Nix Cache (login-only mode)"
else

# Try to kill any lingering magic-nix-cache processes
nix shell nixpkgs#toybox -c killall -s SIGKILL magic-nix-cache || true

if ! command -v magic-nix-cache &>/dev/null; then
  echo "Installing Magic Nix Cache"

  mnc_closure="$(curl -L "${MAGIC_NIX_CACHE_CLOSURE_URL}" |
    xz -d |
    sudo "$(which nix-store)" --import |
    tail -n1 |
    head -n1
  )"
  PATH="${PATH}:/usr/local/bin"
  sudo mkdir -p /usr/local/bin
  sudo ln -sf "${mnc_closure}/bin/magic-nix-cache" /usr/local/bin/magic-nix-cache

  echo "Magic Nix Cache installed"
else
  echo "Magic Nix Cache detected, skipping install"
fi

mnc_log_file="/tmp/mnc-${BUILDKITE_JOB_ID}.log"
mnc_startup_file=/tmp/mnc-startup-"${BUILDKITE_JOB_ID}"

case "${os}" in
  Linux)
    nohup magic-nix-cache --listen "${MAGIC_NIX_CACHE_LISTEN}" \
      --startup-notification-file "${mnc_startup_file}" \
      &> "${mnc_log_file}" &
    ;;
  Darwin)
    nix run nixpkgs#tmux -- new -d -s mnc \
      "magic-nix-cache --listen ${MAGIC_NIX_CACHE_LISTEN} \
        --startup-notification-file ${mnc_startup_file}" \
      \; pipe-pane -t mnc "cat > ${mnc_log_file}"
    ;;
esac
(
  echo "Waiting for Magic Nix Cache to start up..."
  started=0
  for n in {1..30}; do
    if [ -e "${mnc_startup_file}" ]; then
      echo "Magic Nix Cache daemon has successfully started up after ${n} attempt(s)"
      started=1
      break
    else
      echo "Waiting on Magic Nix Cache daemon; on attempt ${n}"
      sleep 2
    fi
  done

  if [[ "${started}" != "1" ]]; then
    echo "The Magic Nix Cache daemon did not start up within 60 seconds; exiting"
    exit 1
  fi
)

fi # push_enabled

# Clean stale Nix binary cache databases between jobs to prevent NAR cache path interference.
# Best-effort: skip missing caches, warn (but don't fail) if a file can't be removed.
for cache_dir in "${HOME}/.cache/nix" /root/.cache/nix; do
  [ -d "${cache_dir}" ] || continue
  find "${cache_dir}" -maxdepth 1 -name 'binary-cache-*.sqlite' \
    -print -delete | sed 's/^/Removed Nix binary cache file: /' \
    || echo "Warning: could not clean some Nix binary cache files in ${cache_dir}"
done
